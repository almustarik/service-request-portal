# Secret used to sign the HTTP-only session cookie (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me-with-a-32-byte-random-hex-string

# Session lifetime in seconds. Defaults to 8 hours.
SESSION_TTL_SECONDS=28800

# Optional: artificial latency (ms) added to server reads in development only,
# to make loading, skeleton and pending states visible. Try 200, 500 or 1000.
# Ignored entirely in production builds.
API_LATENCY_MS=0
